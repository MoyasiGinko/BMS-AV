# ==============================================================================
# Business OS: Production Environment Configuration Template
# Copy this file to .env.prod and fill in all required secrets.
# Never commit real production secrets to version control.
# ==============================================================================

# --- Core Django Settings ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-at-least-50-chars
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=app.example.com,api.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Database (PostgreSQL 18) ---
POSTGRES_DB=bos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgres://postgres:replace-with-strong-db-password@db:5432/bos

# --- Cache & Message Broker (Redis 8) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Symmetric Field-Level Encryption ---
# 32-byte URL-safe base64 key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-encryption-key-for-hr-and-integration-secrets

# --- HTTP Security & SSL ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Public Domain & Reverse Proxy ---
DOMAIN=app.example.com

# --- Mail & SMTP Notification Provider ---
DEFAULT_FROM_EMAIL=notifications@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=smtp-username
EMAIL_HOST_PASSWORD=smtp-password
EMAIL_USE_TLS=True

# --- Observability & Error Tracking ---
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- AI Assistant Providers (Optional) ---
AI_PROVIDER=fake
AI_DEFAULT_MODEL=mock-model-v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
